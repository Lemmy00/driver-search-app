{
  "name": "@roadcred/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -f ./data/test.sqlite && ROADCRED_DB_PATH=./data/test.sqlite NODE_ENV=test node --test --import tsx src/**/*.test.ts"
  },
  "dependencies": {
    "@roadcred/shared": "0.1.0",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.3",
    "tsx": "^4.19.4"
  }
}
